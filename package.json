{
  "name": "riscv-assembly-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "npm run build && python3 -m http.server 4220 --directory .build/site",
    "test": "node --test tests/*.test.js && node tests/background-protocol.cjs",
    "test:browser": "npm run build && playwright test",
    "check:assets": "node tools/check-assets.js",
    "build:course": "node tools/build-course.js",
    "test:course": "node tools/check-course.js",
    "build:editor": "node tools/build-editor.js",
    "test:reference": "node tools/reference-recordings.js --check",
    "test:counter": "node tools/check-counter-wrap.js",
    "build": "npm run build:course && node tools/build-site.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@playwright/test": "1.56.1",
    "esbuild": "0.28.2"
  }
}
